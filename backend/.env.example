# 环境变量配置

# 数据库配置
# SQLite 地址
DATABASE_URL=sqlite+aiosqlite:///resource/database.db
# MySQL 数据库
# DATABASE_URL=mysql+aiomysql://root:root@localhost/qizhi-agent

# 应用配置
DEBUG=True
APP_NAME=企知 Agent
# 允许访问 API 的前端来源，多个来源用逗号分隔
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
AGENT_STATE_DB=resource/agent_state.db
AGENT_TRACE_DB=resource/agent_traces.db
AGENT_MAX_STEP_ATTEMPTS=2
AGENT_RUN_TIMEOUT_SECONDS=180

# OpenAI
OPENAI_BASE_URL=
OPENAI_API_KEY=
DEFAULT_MODEL=gpt-5.6-sol

# OpenAI embedding model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB 的相对存储路径
CHROMA_PATH=resource/chroma_db

# MCP（可选）。相对路径以 backend 目录为基准；留空则不启用 MCP 智能体。
# 先复制 mcp_servers.example.json 为 mcp_servers.json，再按需修改。
MCP_CONFIG_PATH=


